cmake_minimum_required(VERSION 3.0...3.10)
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
if(NOT OUT)
  set(OUT "${LIBDIR}/zip115-test")
endif()
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${JAVA}" -classpath "${JDK}/lib/classes.zip${sep}${ROOT}/tests/vm" ZipLibrary115 "${OUT}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "zip library passed\n")
  message(FATAL_ERROR "ZIP library failure (${status}): ${output}${error}")
endif()

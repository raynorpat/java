# Build the private native registry from the exact sources compiled by stubs.c.
# This is not the public export manifest: legacy adapters remain usable internally.
file(STRINGS "${CMAKE_SOURCE_DIR}/src/share/java/runtime/stubs.c" stub_lines)
set(registry "/* Generated from stubs.c; do not edit. */\n")
foreach(line ${stub_lines})
  if(line MATCHES "^#include \"(_stubs/[^\"]+)\"")
    set(stub_path "${CMAKE_SOURCE_DIR}/src/share/java/runtime/${CMAKE_MATCH_1}")
    if(EXISTS "${stub_path}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${stub_path}")
      file(READ "${stub_path}" stub_source)
      string(REGEX MATCHALL "Java_[A-Za-z0-9_]+_stub[ \t\r\n]*\\(" stub_names "${stub_source}")
      foreach(entry ${stub_names})
        string(REGEX REPLACE "[ \t\r\n]*\\($" "" entry "${entry}")
        set(registry "${registry}    { \"${entry}\", ${entry} },\n")
      endforeach()
    endif()
  elseif(line MATCHES "^#(ifdef|ifndef|if|else|endif)")
    set(registry "${registry}${line}\n")
  endif()
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_SOURCE_DIR}/src/share/java/runtime/stubs.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
file(WRITE "${CMAKE_BINARY_DIR}/generated/builtin-natives.inc" "${registry}")

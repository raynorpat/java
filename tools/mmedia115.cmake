cmake_minimum_required(VERSION 3.0...3.10)
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
execute_process(COMMAND "${JAVA}" -classpath "${JDK}/lib/classes.zip${sep}${ROOT}/tests/vm" AudioLibrary115
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL "audio library passed\n" OR NOT error STREQUAL "")
  message(FATAL_ERROR "Audio library failure (${status}): ${output}${error}")
endif()

cmake_minimum_required(VERSION 3.0...3.10)
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
set(ENV{JAVA_HOME} "${JDK}")
file(MAKE_DIRECTORY "${OUT}")
set(cp "${OUT}${sep}${JDK}/lib/classes.zip${sep}${ROOT}/tests/vm")
execute_process(COMMAND "${RMIC}" -classpath "${cp}" -d "${OUT}" Net115RemoteImpl
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT result EQUAL 0 OR NOT EXISTS "${OUT}/Net115RemoteImpl_Stub.class" OR NOT EXISTS "${OUT}/Net115RemoteImpl_Skel.class")
  message(FATAL_ERROR "rmic failed (${result}): ${output}${error}")
endif()
execute_process(COMMAND "${JAVA}" -classpath "${cp}" Net115RMI
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT result EQUAL 0 OR NOT output STREQUAL "rmi=ok\n")
  message(FATAL_ERROR "RMI failed (${result}): ${output}${error}")
endif()

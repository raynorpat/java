cmake_minimum_required(VERSION 3.0...3.10)
execute_process(COMMAND "${DUMPBIN}" /nologo /exports "${DLL}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Cannot inspect exports: ${errors}")
endif()
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
set(actual)
foreach(line ${lines})
  if(line MATCHES "^[ ]+[0-9]+[ ]+[0-9A-Fa-f]+[ ]+[0-9A-Fa-f]+[ ]+([^ =]+)")
    list(APPEND actual "${CMAKE_MATCH_1}")
  endif()
endforeach()
file(STRINGS "${REFERENCE}" expected)
set(missing)
set(extra ${actual})
foreach(name ${expected})
  list(FIND actual "${name}" found)
  if(found EQUAL -1)
    list(APPEND missing "${name}")
  endif()
  list(REMOVE_ITEM extra "${name}")
endforeach()
list(SORT missing)
list(SORT extra)
string(REPLACE ";" "\n" missing "${missing}")
string(REPLACE ";" "\n" extra "${extra}")
if(NOT "${missing}" STREQUAL "" OR NOT "${extra}" STREQUAL "")
  message(FATAL_ERROR "Missing Sun exports:\n${missing}\nExtra exports:\n${extra}")
endif()

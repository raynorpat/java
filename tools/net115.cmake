cmake_minimum_required(VERSION 3.0...3.10)
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
set(tests Net115 Net115Close Net115PeekClose)
if(UNIX)
  list(APPEND tests Net115HighFD)
endif()
foreach(test ${tests})
  execute_process(COMMAND "${JAVA}" -classpath "${JDK}/lib/classes.zip${sep}${ROOT}/tests/vm" ${test}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  string(REPLACE "\r\n" "\n" output "${output}")
  file(READ "${ROOT}/tests/vm/${test}.expected" expected)
  string(REPLACE "\r\n" "\n" expected "${expected}")
  if(NOT result EQUAL 0 OR NOT output STREQUAL expected)
    message(FATAL_ERROR "${test} failed (${result}): ${output}${error}")
  endif()
endforeach()

cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}/bin" "${OUT}/lib/security")
file(COPY "${JRE}" DESTINATION "${OUT}/bin")
if(WIN32)
  file(COPY "${VM}" DESTINATION "${OUT}/bin")
  set(JAVA "${OUT}/bin/jre.exe")
  set(sep ";")
else()
  file(COPY "${VM}" DESTINATION "${OUT}/lib")
  set(JAVA "${OUT}/bin/jre")
  set(sep ":")
endif()
file(COPY "${JDK115_DIR}/lib/security/java.security" DESTINATION "${OUT}/lib/security")
set(CP "${ROOT}/tests/vm${sep}${JDK115_DIR}/lib/classes.zip")

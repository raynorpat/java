cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}/input" "${OUT}/extract")
if(WIN32)
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
set(ENV{CLASSPATH} "${JDK}/lib/classes.zip")
function(run tool dir)
  execute_process(COMMAND "${tool}" ${ARGN} WORKING_DIRECTORY "${dir}"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "jar ${ARGN} failed (${status}): ${stdout}${stderr}")
  endif()
endfunction()
file(WRITE "${OUT}/input/first.txt" "first payload\n")
file(WRITE "${OUT}/input/second.txt" "second payload\n")
run("${JAR}" "${OUT}/input" cf "${OUT}/archive.jar" first.txt second.txt)
# Sun 1.1.5 has no update operation: preserve its rejection.
execute_process(COMMAND "${JAR}" uf "${OUT}/archive.jar" first.txt
  WORKING_DIRECTORY "${OUT}/input" RESULT_VARIABLE status
  OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT status EQUAL 1 OR NOT "${stdout}${stderr}" MATCHES "Illegal option: u")
  message(FATAL_ERROR "jar update must match Sun 1.1.5 rejection")
endif()
run("${JAR}" "${OUT}/input" tf "${OUT}/archive.jar")
if(NOT READER)
  set(READER "${JAR}")
endif()
run("${READER}" "${OUT}/extract" xf "${OUT}/archive.jar")
file(READ "${OUT}/extract/first.txt" first)
file(READ "${OUT}/extract/second.txt" second)
if(NOT first STREQUAL "first payload\n" OR NOT second STREQUAL "second payload\n")
  message(FATAL_ERROR "jar create/update/extract changed file contents")
endif()

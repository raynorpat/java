cmake_minimum_required(VERSION 3.0...3.10)
foreach(required JAVA CP CLASS EXPECTED)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
if(NOT EXISTS "${JAVA}" OR NOT EXISTS "${EXPECTED}")
  message(FATAL_ERROR "Missing Java executable or expected-output file")
endif()
if(NOT CMAKE_VERSION VERSION_LESS 3.8)
  set(output_encoding ENCODING NONE)
endif()
execute_process(COMMAND "${JAVA}" ${VM_ARGS} -classpath "${CP}" "${CLASS}" ${ARGS}
  RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE actual TIMEOUT 30 ${output_encoding})
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Java failed (${status}): ${actual}")
endif()
file(READ "${EXPECTED}" expected)
string(REPLACE "\r\n" "\n" actual "${actual}")
string(REPLACE "\r\n" "\n" expected "${expected}")
if(NOT "${actual}" STREQUAL "${expected}")
  message(FATAL_ERROR "Output mismatch for ${CLASS}\nExpected:\n${expected}\nActual:\n${actual}")
endif()

cmake_minimum_required(VERSION 3.0...3.10)
if(NOT IS_DIRECTORY "${FROM}")
  message(FATAL_ERROR "Pass -DFROM=<reference distribution directory>")
endif()
if(NOT DEFINED TO)
  set(TO jdk1.1.5)
endif()
if(NOT TO STREQUAL "jdk1.1.5" AND NOT TO STREQUAL "rhapsody-dr2")
  message(FATAL_ERROR "TO must be jdk1.1.5 or rhapsody-dr2")
endif()
if(TO STREQUAL "jdk1.1.5" AND NOT EXISTS "${FROM}/lib/classes.zip")
  message(FATAL_ERROR "FROM does not contain lib/classes.zip")
endif()
file(COPY "${FROM}/" DESTINATION "${CMAKE_CURRENT_LIST_DIR}/../vendor/${TO}")

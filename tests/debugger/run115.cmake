cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
if(LAUNCH AND BUILD_DIR)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef image_id)
  set(image "${OUT}/image-${image_id}")
  if(UNIX)
    # WSL-mounted build directories make installation metadata writes very slow.
    # Keep the real install test on the host's temporary filesystem.
    set(image_root "$ENV{TMPDIR}")
    if(NOT image_root)
      set(image_root /tmp)
    endif()
    set(image "${image_root}/jdk115-debugger-${image_id}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
    --prefix "${image}" RESULT_VARIABLE installed
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
  if(NOT "${installed}" STREQUAL "0")
    message(FATAL_ERROR "Debugger image install failed: ${output}${errors}")
  endif()
  file(WRITE "${OUT}/installed-image.txt" "${image}\n")
  if(WIN32)
    set(JAVA "${image}/bin/java.exe")
    set(JDB "${image}/bin/jdb.exe")
    set(LIBDIR "${image}/bin")
  else()
    set(JAVA "${image}/bin/java")
    set(JDB "${image}/bin/jdb")
    set(LIBDIR "${image}/lib")
  endif()
endif()
execute_process(COMMAND "${JAVAC}" -g -d "${OUT}" Debuggee115.java Exception115.java
  WORKING_DIRECTORY "${ROOT}/tests/debugger"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Debuggee compile failed: ${output}${errors}")
endif()
if(WIN32)
  set(cp "${OUT};${JDK}/lib/classes.zip")
else()
  set(cp "${OUT}:${JDK}/lib/classes.zip")
endif()
set(mode)
if(STOPPED)
  set(mode --stop-after-breakpoint)
elseif(RELEASE_REJECTION)
  set(mode --expect-release-rejection)
elseif(LAUNCH)
  set(mode --launch)
  if(WRAPPER)
    list(APPEND mode --process-wrapper "${WRAPPER}")
  endif()
elseif(EXCEPTION_MODE)
  set(mode --exception-mode "${EXCEPTION_MODE}")
endif()
execute_process(COMMAND "${PYTHON}" "${ROOT}/tests/debugger/session115.py"
  --java "${JAVA}" --jdb "${JDB}" --classpath "${cp}"
  --libdir "${LIBDIR}" --out "${OUT}/session" ${mode}
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Debugger session failed: ${output}${errors}")
endif()
message(STATUS "${output}")

cmake_minimum_required(VERSION 3.0...3.10)
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
set(cp "${JDK}/lib/classes.zip${sep}${OUT}/tests")
if(MODE STREQUAL "link")
  set(class PeerLink115)
  set(arguments "${OUT}/motif-peers.zip")
  set(expected "defined peers=76 resolved button target and interface verified")
else()
  set(class sun.awt.im.InputContextTest115)
  if(WIN32)
    set(arguments "${LIBDIR}/motif118probe.dll")
  else()
    set(arguments "${LIBDIR}/libmotif118probe.so")
  endif()
  set(archive motif-peers.zip)
  if(MODE STREQUAL "reference")
    set(archive motif-raw.zip)
  endif()
  set(cp "${cp}${sep}${OUT}/${archive}")
  set(expected "peer field layout and input-context lifecycle passed")
endif()
execute_process(COMMAND "${JAVA}" -classpath "${cp}" ${class} ${arguments}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
string(STRIP "${output}" output)
if(NOT "${result}" STREQUAL "0" OR NOT "${output}" STREQUAL "${expected}" OR NOT "${errors}" STREQUAL "")
  message(FATAL_ERROR "Motif ${MODE}: ${result}\n${output}${errors}")
endif()
message(STATUS "${output}")

cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}/tests")
set(cp "${JDK}/lib/classes.zip:${OUT}/tests:${OUT}/motif-peers.zip")
execute_process(COMMAND "${JAVAC}" -classpath "${cp}" -d "${OUT}/tests" "${CLASS}.java"
  WORKING_DIRECTORY "${ROOT}/tests/awt118" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Compile ${CLASS}: ${result}\n${output}${errors}")
endif()
set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
if(MODE STREQUAL "no-display")
  set(ENV{DISPLAY} ":65530")
  set(command "${JAVA}" "-Djava.home=${OUT}/home" -classpath "${cp}" "${CLASS}" no-display)
  set(expected "display failure reported")
else()
  set(command xvfb-run -a -s "-screen 0 800x600x24 -nolisten tcp" "${JAVA}" "-Djava.home=${OUT}/home" -classpath "${cp}" "${CLASS}")
  set(expected "toolkit display, colors and idle monitor passed")
  if(CLASS STREQUAL "Fonts115")
    set(expected "font metrics and byte bounds passed")
  elseif(CLASS STREQUAL "Window115")
    set(expected "window paint, click, event dispatch and disposal passed")
  endif()
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
string(STRIP "${output}" output)
if(NOT "${result}" STREQUAL "0" OR NOT "${output}" STREQUAL "${expected}" OR NOT "${errors}" STREQUAL "")
  message(FATAL_ERROR "${CLASS}: ${result}\n${output}${errors}")
endif()

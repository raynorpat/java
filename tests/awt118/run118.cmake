cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}/tests")
set(cp "${JDK}/lib/classes.zip:${OUT}/tests:${OUT}/motif-peers.zip")
set(sources "${CLASS}.java")
set(main_class "${CLASS}")
if(CLASS STREQUAL "Surface115" OR CLASS STREQUAL "InputThread115")
  set(main_class "sun.awt.motif.${CLASS}")
endif()
if(CLASS STREQUAL "DecoderImages115" OR CLASS STREQUAL "GifRaster115")
  set(sources "${ROOT}/tests/awt/${CLASS}.java")
endif()
if(CLASS STREQUAL "OwnedWindow115" OR CLASS STREQUAL "Dialog115" OR CLASS STREQUAL "Embedded115" OR CLASS STREQUAL "Decorated115")
  list(APPEND sources Window115.java)
endif()
if(CLASS STREQUAL "Input115" OR CLASS STREQUAL "Widgets115" OR CLASS STREQUAL "List115" OR CLASS STREQUAL "Choice115" OR CLASS STREQUAL "Scrollbar115" OR CLASS STREQUAL "TextField115" OR CLASS STREQUAL "TextArea115" OR CLASS STREQUAL "Raster115" OR CLASS STREQUAL "Image115")
  list(APPEND sources Window115.java)
endif()
if(CLASS STREQUAL "InputMethod115")
  list(APPEND sources Window115.java)
endif()
if(CLASS STREQUAL "List115" OR CLASS STREQUAL "Choice115" OR CLASS STREQUAL "TextField115" OR CLASS STREQUAL "TextArea115" OR CLASS STREQUAL "InputMethod115")
  list(APPEND sources Input115.java)
endif()
execute_process(COMMAND "${JAVAC}" -classpath "${cp}" -d "${OUT}/tests" ${sources}
  WORKING_DIRECTORY "${ROOT}/tests/awt118" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Compile ${CLASS}: ${result}\n${output}${errors}")
endif()
set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
if(NOT DEPTH)
  set(DEPTH 24)
endif()
if(CLASS STREQUAL "Visual115")
  set(ENV{FORCEDEFVIS} 1)
endif()
if(MODE STREQUAL "no-display")
  set(ENV{DISPLAY} ":65530")
  set(command "${JAVA}" "-Djava.home=${OUT}/home" -classpath "${cp}" "${CLASS}" no-display)
  set(expected "display failure reported")
else()
  set(command xvfb-run -a -s "-screen 0 800x600x${DEPTH} -nolisten tcp" "${JAVA}" "-Djava.home=${OUT}/home"
    "-Dawt.toolkit=sun.awt.motif.MToolkit" "-Dmotif.selection.helper=${LIBDIR}/../bin/motif118selection" -classpath "${cp}" "${main_class}")
  set(expected "toolkit display, colors and idle monitor passed")
  if(CLASS STREQUAL "Decorated115")
    set(command xvfb-run -a -s "-screen 0 800x600x24 -nolisten tcp"
      sh "${ROOT}/tests/awt118/with-wm.sh" "${JAVA}" "-Djava.home=${OUT}/home"
      -classpath "${cp}" "${main_class}")
    set(expected "decorated frame bounds and client layout passed")
  elseif(CLASS STREQUAL "LatePanel115")
    set(expected "late applet and nested panel geometry passed")
  elseif(CLASS STREQUAL "Fonts115")
    set(expected "font metrics and byte bounds passed")
  elseif(CLASS STREQUAL "Window115")
    set(expected "window paint, click, event dispatch and disposal passed")
  elseif(CLASS STREQUAL "Input115")
    set(expected "mouse, keyboard, focus and consumption passed")
  elseif(CLASS STREQUAL "InputMethod115")
    set(expected "XIM activation, keyboard delivery and disposal passed")
  elseif(CLASS STREQUAL "InputThread115")
    set(expected "input readiness notification and dispatch passed")
  elseif(CLASS STREQUAL "Embedded115")
    set(expected "embedded host shells, callbacks and retirement passed")
  elseif(CLASS STREQUAL "Widgets115")
    set(expected "labels, checkboxes and radio groups passed")
  elseif(CLASS STREQUAL "List115")
    set(expected "list selection, mutation, scrolling and activation passed")
  elseif(CLASS STREQUAL "Choice115")
    set(expected "choice selection, popup, mutation and disposal passed")
  elseif(CLASS STREQUAL "Scrollbar115")
    set(expected "scrollbar range, callbacks, repeat and disposal passed")
  elseif(CLASS STREQUAL "TextField115")
    set(expected "text field editing, selection, echo and disposal passed")
  elseif(CLASS STREQUAL "TextArea115")
    set(expected "text area edits, selection, scrolling and disposal passed")
  elseif(CLASS STREQUAL "ScrollPane115")
    set(expected "scroll pane policies, geometry, callbacks and disposal passed")
  elseif(CLASS STREQUAL "Raster115")
    set(expected "graphics primitives, text, clipping, XOR and copying passed")
  elseif(CLASS STREQUAL "Image115")
    set(expected "offscreen image painting, delivery and retirement passed")
  elseif(CLASS STREQUAL "Menus115")
    set(expected "menu activation, mutation and disposal passed")
  elseif(CLASS STREQUAL "OwnedWindow115")
    set(expected "owned window geometry, painting and disposal passed")
  elseif(CLASS STREQUAL "Dialog115")
    set(expected "dialog modality, callbacks and disposal passed")
  elseif(CLASS STREQUAL "FileDialog115")
    set(expected "file dialog selection, filtering and cancellation passed")
  elseif(CLASS STREQUAL "Clipboard115")
    set(expected "clipboard ownership, targets and external transfer passed")
  elseif(CLASS STREQUAL "Codec115")
    set(expected "GIF decoding and transparency passed")
  elseif(CLASS STREQUAL "Surface115")
    set(expected "drawing surface state, visuals and retirement passed")
  elseif(CLASS STREQUAL "Icon115")
    set(expected "frame icon sizing, replacement and retirement passed")
  elseif(CLASS STREQUAL "Visual115")
    list(APPEND command "${DEPTH}")
    set(expected "visual color model, image conversion and delivery passed")
  elseif(CLASS STREQUAL "Print115")
    list(APPEND command "${OUT}/tests/Print115.ps")
    set(expected "PostScript pages, text and color images passed")
  elseif(CLASS STREQUAL "DecoderImages115")
    list(APPEND command rgb)
    set(expected "decoder 0 16777215\ndecoder 1 -1130146988\ndecoder 2 -1507203232\ndecoder 3 -1130146988\nGIF and baseline, gray, progressive JPEG drawing passed")
  elseif(CLASS STREQUAL "GifRaster115")
    list(APPEND command rgb)
    set(expected "GIF 0 -1283822210\nGIF 1 -1283822210\ninterlaced and non-interlaced GIF LZW dictionary drawing passed")
  endif()
endif()
if(MODE STREQUAL "window-manager")
  set(command xvfb-run -a -s "-screen 0 800x600x24 -nolisten tcp"
    sh "${ROOT}/tests/awt118/with-wm.sh" "${JAVA}" "-Djava.home=${OUT}/home"
    -classpath "${cp}" "${main_class}")
endif()
set(run_timeout 20)
if(CLASS STREQUAL "Decorated115" OR MODE STREQUAL "window-manager")
  set(run_timeout 40)
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${run_timeout})
string(STRIP "${output}" output)
if(NOT "${result}" STREQUAL "0" OR NOT "${output}" STREQUAL "${expected}" OR NOT "${errors}" STREQUAL "")
  message(FATAL_ERROR "${CLASS}: ${result}\n${output}${errors}")
endif()

if(CLASS STREQUAL "Print115")
  execute_process(COMMAND gs -q -dSAFER -dBATCH -dNOPAUSE -sDEVICE=ppmraw -r72
    "-sOutputFile=${OUT}/tests/Print115-%d.ppm" "${OUT}/tests/Print115.ps"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Render PostScript: ${result}\n${output}${errors}")
  endif()
  execute_process(COMMAND python3 "${ROOT}/tests/awt118/check-print.py" "${OUT}/tests"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Check PostScript: ${result}\n${output}${errors}")
  endif()
  execute_process(COMMAND gs -q -dSAFER -dBATCH -dNOPAUSE -sDEVICE=nullpage "${OUT}/tests/Print115.ps.dialog"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Render toolkit print: ${result}\n${output}${errors}")
  endif()
endif()

cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
foreach(mode probe format1 format2 foreign)
  set(report "${OUT}/${mode}.jcov")
  file(REMOVE "${report}" "${report}.temp" "${report}.temp.lock")
  if(NOT mode STREQUAL "probe")
    configure_file("${ROOT}/tests/native/jcov115-${mode}.seed" "${report}" @ONLY NEWLINE_STYLE UNIX)
  endif()
  execute_process(COMMAND "${PROBE}" "${report}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  if(NOT "${status}" STREQUAL "0" OR NOT "${output}${errors}" STREQUAL "")
    message(FATAL_ERROR "JCOV native ${mode}: exit=${status} ${output}${errors}")
  endif()
  file(READ "${report}" actual)
  file(READ "${ROOT}/tests/native/jcov115-${mode}.expected" expected)
  string(REPLACE "\r\n" "\n" actual "${actual}")
  string(REPLACE "\r\n" "\n" expected "${expected}")
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "JCOV native ${mode} differs from Sun oracle:\n${actual}")
  endif()
endforeach()

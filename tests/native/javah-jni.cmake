cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${JAVAH}" -jni -classpath "${CP}" -d "${OUT}" JNI_Test NativeHello
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "javah -jni failed: ${output}")
endif()
foreach(pair "JNI_0005fTest|JNI_Test" "NativeHello|NativeHello")
  string(REPLACE "|" ";" names "${pair}")
  list(GET names 0 actual_name)
  list(GET names 1 expected_name)
  file(READ "${OUT}/${actual_name}.h" actual)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/${expected_name}.jni.expected.h" expected)
  string(REPLACE "\r\n" "\n" actual "${actual}")
  string(REPLACE "\r\n" "\n" expected "${expected}")
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "JNI header differs from Sun 1.1.5 oracle: ${actual_name}")
  endif()
endforeach()
execute_process(COMMAND "${JAVAH}" -jni -stubs -classpath "${CP}" NativeHello
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
if("${status}" STREQUAL "0" OR NOT output MATCHES "The JNI does not need stub files")
  message(FATAL_ERROR "javah accepted incompatible -jni -stubs flags")
endif()

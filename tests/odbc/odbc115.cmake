cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
set(cscript "$ENV{SystemRoot}/SysWOW64/cscript.exe")
execute_process(COMMAND powershell -NoProfile -Command
  "Get-OdbcDriver -Platform '32-bit' | Format-List Name,Platform,Attribute"
  OUTPUT_FILE "${OUT}/drivers.txt" RESULT_VARIABLE inventory TIMEOUT 20)
if(NOT inventory EQUAL 0)
  message(FATAL_ERROR "Cannot inventory 32-bit ODBC drivers")
endif()
file(READ "${OUT}/drivers.txt" drivers)
if(NOT drivers MATCHES "Microsoft Access Driver")
  message(FATAL_ERROR "ODBC SQL tests require the 32-bit Microsoft Access (*.mdb) driver; see ${OUT}/drivers.txt")
endif()
set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
set(classes JdbcOdbcAbi115 JdbcOdbc115 JdbcOdbcData115)
foreach(class ${classes})
  file(TO_NATIVE_PATH "${ROOT}/tests/odbc/${class}.java" source)
  execute_process(COMMAND "${JAVA}" -classpath "${JDK}/lib/classes.zip"
    sun.tools.javac.Main -d "${OUT}" "${source}"
    RESULT_VARIABLE compiled OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  if(NOT compiled EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "ODBC fixture compile failed (${compiled}): ${output}${errors}")
  endif()
endforeach()
if(CONFIG STREQUAL "Debug")
  set(original "${JDK}/bin/java_g.exe")
else()
  set(original "${JDK}/bin/java.exe")
endif()
foreach(class ${classes})
  foreach(variant original rebuilt)
    set(arguments)
    if(NOT class STREQUAL "JdbcOdbcAbi115")
      set(database "${OUT}/${class}-${variant}.mdb")
      file(REMOVE "${database}" "${OUT}/${class}-${variant}.ldb")
      execute_process(COMMAND "${cscript}" //nologo "${ROOT}/tests/odbc/create-database.js" "${database}"
        RESULT_VARIABLE created OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
      if(NOT created EQUAL 0)
        message(FATAL_ERROR "Cannot create temporary Access fixture: ${output}${errors}")
      endif()
      list(APPEND arguments "${database}")
    endif()
    if(variant STREQUAL "original")
      set(runtime "${original}")
      set(ENV{PATH} "${JDK}/bin;$ENV{PATH}")
    else()
      set(runtime "${JAVA}")
      set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
    endif()
    execute_process(COMMAND "${runtime}" -classpath "${OUT};${JDK}/lib/classes.zip"
      "${class}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    string(REPLACE "\r\n" "\n" output "${output}")
    file(WRITE "${OUT}/${class}-${variant}.stdout" "${output}")
    file(WRITE "${OUT}/${class}-${variant}.stderr" "${errors}")
    if(NOT status EQUAL 0 OR NOT errors STREQUAL "")
      message(FATAL_ERROR "${class} ${variant} failed (${status}): ${output}${errors}")
    endif()
    if(variant STREQUAL "original")
      set(expected "${output}")
    elseif(NOT output STREQUAL expected)
      message(FATAL_ERROR "${class} differs from Sun: ${output}; expected: ${expected}")
    endif()
  endforeach()
endforeach()

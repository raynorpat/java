cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${BIN}/javadoc${EXE}" -d "${OUT}" -author -version
  "${ROOT}/tests/tools/Documented115.java" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "javadoc failed: ${result}, ${output}, ${errors}")
endif()
# Exercise the original javakey class with a private test database.
if(WIN32)
  set(cp "${ROOT}/tests/tools;${HOME115}/lib/classes.zip")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(cp "${ROOT}/tests/tools:${HOME115}/lib/classes.zip")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
file(REMOVE "${OUT}/identitydb.obj")
foreach(operation create generate list remove)
  if(operation STREQUAL "create")
    set(arguments -cs phase2 true)
    set(expected "Created identity ")
  elseif(operation STREQUAL "generate")
    set(arguments -gk phase2 DSA 512)
    set(expected "Generated DSA keys for phase2 (strength: 512).")
  elseif(operation STREQUAL "list")
    set(arguments -li phase2)
    set(expected "public and private keys initialized")
  else()
    set(arguments -r phase2)
    set(expected "Removed phase2.")
  endif()
  execute_process(COMMAND "${BIN}/java${EXE}" -classpath "${cp}"
    KeyTool115 "${OUT}/identitydb.obj" ${arguments} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  string(FIND "${output}" "${expected}" found)
  if(NOT "${result}" STREQUAL "0" OR found EQUAL -1)
    message(FATAL_ERROR "javakey ${operation}: ${result}, ${output}, ${errors}")
  endif()
endforeach()
file(READ "${OUT}/Documented115.html" html)
foreach(expected "A documented Phase 2 fixture" "Reconstruction test" "1.1.5" "Adds one to the argument" "the next value")
  string(FIND "${html}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing generated documentation: ${expected}")
  endif()
endforeach()
foreach(generated tree.html AllNames.html packages.html)
  if(NOT EXISTS "${OUT}/${generated}")
    message(FATAL_ERROR "Missing javadoc navigation: ${generated}")
  endif()
endforeach()
# No identity database mutation: this option only displays usage.
execute_process(COMMAND "${BIN}/javakey${EXE}" -help RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "list of the identities in the database")
  message(FATAL_ERROR "javakey help failed: ${result}, ${output}, ${errors}")
endif()

cmake_minimum_required(VERSION 3.0...3.10)
file(READ "${GEN}/sun_tools_debug_Agent.c" agent)
file(READ "${GEN}/sun_tools_debug_BreakpointHandler.c" breakpoints)
string(REGEX MATCHALL "Java_sun_tools_debug_[A-Za-z0-9_]+_stub" actual "${agent}${breakpoints}")
list(REMOVE_DUPLICATES actual)
file(STRINGS "${ROOT}/tools/exports-agent115.txt" expected)
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
  message(FATAL_ERROR "Generated agent bindings differ from the original exports")
endif()

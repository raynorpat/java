cmake_minimum_required(VERSION 3.0...3.10)
# Verify installed launchers, resources and all six native support libraries.
set(BIN "${IMAGE}/bin")
set(HOME115 "${IMAGE}")
set(JDK "${IMAGE}")
if(WIN32)
  set(EXE ".exe")
  set(LIBDIR "${BIN}")
  set(probe "jpeg115probe.dll")
else()
  set(EXE "")
  set(LIBDIR "${IMAGE}/lib")
  set(probe "libjpeg115probe.so")
endif()
set(JAVA "${BIN}/java${EXE}")
set(base "${OUT}")
set(OUT "${base}/native2ascii")
set(TOOL "${BIN}/native2ascii${EXE}")
include("${ROOT}/tests/tools/native2ascii115.cmake")
include("${ROOT}/tests/tools/console115.cmake")
set(OUT "${base}/documentation")
include("${ROOT}/tests/tools/documentation115.cmake")
set(TOOL "${BIN}/java-rmi.cgi")
include("${ROOT}/tests/tools/cgi115.cmake")
set(OUT "${base}/zip")
include("${ROOT}/tools/zip115.cmake")
set(JAR "${BIN}/jar${EXE}")
set(OUT "${base}/jar")
include("${ROOT}/tools/zip115-jar.cmake")
include("${ROOT}/tools/net115.cmake")
set(RMIC "${BIN}/rmic${EXE}")
set(OUT "${base}/rmi")
include("${ROOT}/tools/net115-rmi.cmake")
set(CLASS MathLibrary115)
include("${ROOT}/tests/vm/math-resource115.cmake")
set(CLASS ResourceLibrary115)
set(RESOURCE "${ROOT}/tests/vm/resources115.zip")
include("${ROOT}/tests/vm/math-resource115.cmake")
include("${ROOT}/tools/mmedia115.cmake")
# Only the test bridge is staged separately; its jpeg dependency resolves from
# the installed image, rather than from the build directory beside the bridge.
file(MAKE_DIRECTORY "${base}/probe")
configure_file("${PROBE_DIR}/${probe}" "${base}/probe/${probe}" COPYONLY)
if(WIN32)
  set(ENV{PATH} "${LIBDIR};${base}/probe;$ENV{PATH}")
else()
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:${base}/probe:$ENV{LD_LIBRARY_PATH}")
endif()
set(OUT "${base}/jpeg")
include("${ROOT}/tests/vm/jpeg115.cmake")
message(STATUS "Installed Phase 2 image checks passed")

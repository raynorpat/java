cmake_minimum_required(VERSION 3.0...3.10)
if(NOT EXISTS "${TOOL}")
  message(FATAL_ERROR "native2ascii launcher missing: ${TOOL}")
endif()
file(MAKE_DIRECTORY "${OUT}")
configure_file("${ROOT}/tests/tools/native2ascii115.in" "${OUT}/input utf8.txt" COPYONLY)
file(READ "${ROOT}/tests/tools/native2ascii115.expected" ascii)
file(READ "${ROOT}/tests/tools/native2ascii115.in" native)
function(run_tool expected_status expected_output)
  execute_process(COMMAND "${TOOL}" ${ARGN} WORKING_DIRECTORY "${OUT}"
    INPUT_FILE "${OUT}/input utf8.txt" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  string(REPLACE "\r\n" "\n" output "${output}")
  if(NOT "${status}" STREQUAL "${expected_status}" OR
      NOT "${output}" STREQUAL "${expected_output}" OR NOT "${errors}" STREQUAL "")
    message(FATAL_ERROR "native2ascii ${ARGN}: exit=${status}, stdout=[${output}], stderr=[${errors}]")
  endif()
endfunction()
run_tool(0 "" -encoding UTF8 "input utf8.txt" "output ascii.txt")
file(READ "${OUT}/output ascii.txt" actual)
if(NOT "${actual}" STREQUAL "${ascii}")
  message(FATAL_ERROR "Forward conversion differs from Sun: ${actual}")
endif()
run_tool(0 "" -reverse -encoding UTF8 "output ascii.txt" "output utf8.txt")
file(READ "${OUT}/output utf8.txt" actual)
if(NOT "${actual}" STREQUAL "${native}")
  message(FATAL_ERROR "Reverse conversion differs from Sun: ${actual}")
endif()
run_tool(0 "${ascii}" -encoding UTF8)
run_tool(1 "java.lang.Exception: -J-ms16m can not be read.\n" -J-ms16m)
run_tool(1 "-encoding requires argument\nUsage: native2ascii [-reverse] [-encoding encoding] [inputfile [outputfile]]\n" -encoding)

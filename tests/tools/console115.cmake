cmake_minimum_required(VERSION 3.0...3.10)
set(ENV{JAVA_HOME} "${HOME115}")
function(check tool status stdout stderr)
  execute_process(COMMAND "${BIN}/${tool}${EXE}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  string(REPLACE "\r\n" "\n" output "${output}")
  string(REPLACE "\r\n" "\n" errors "${errors}")
  if(NOT "${result}" STREQUAL "${status}" OR
      NOT "${output}" STREQUAL "${stdout}" OR NOT "${errors}" STREQUAL "${stderr}")
    message(FATAL_ERROR "${tool}: exit=${result}, stdout=[${output}], stderr=[${errors}]")
  endif()
endfunction()
check(serialver 0 "java.lang.String:    static final long serialVersionUID = -6849794470754667710L;\njava.lang.Integer:    static final long serialVersionUID = 1360826667806852920L;\n" "" java.lang.String java.lang.Integer)
check(serialver 0 "java.lang.String:    static final long serialVersionUID = -6849794470754667710L;\n" "" -J-ms16m java.lang.String)
check(rmic 1 "rmic: invalid flag: -help\nuse: rmic [-g][-O][-debug][-depend][-nowarn][-verbose][-classpath path][-nowrite][-d dir][-dstub dir][-dskel dir][-show][-keepgenerated] classname...\n" "" -help)
check(rmiregistry 1 "Port is not a number.\n" "" -help)
set(ENV{JAVA_HOME} "missing-jdk115-home")
foreach(tool serialver rmic rmiregistry)
  check(${tool} 1 "" "Invalid JAVA_HOME: missing-jdk115-home\n")
endforeach()

cmake_minimum_required(VERSION 3.0...3.10)
if(LIBDIR)
  if(WIN32)
    set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
  else()
    set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
  endif()
endif()
# Captured from the unchanged Windows JDK 1.1.5 jdb launcher.
foreach(case help version passthrough)
  if(case STREQUAL "passthrough")
    set(option -J-ms16m)
  else()
    set(option -${case})
  endif()
  execute_process(COMMAND "${TOOL}" "${option}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
  if(CAPTURE)
    if(NOT "${status}" MATCHES "^[0-9]+$")
      message(FATAL_ERROR "Oracle did not exit: ${status}")
    endif()
    file(WRITE "${FIXTURES}/jdb-${case}.status" "${status}")
    file(WRITE "${FIXTURES}/jdb-${case}.stdout" "${output}")
    file(WRITE "${FIXTURES}/jdb-${case}.stderr" "${errors}")
  else()
    foreach(stream status stdout stderr)
      file(READ "${FIXTURES}/jdb-${case}.${stream}" expected_${stream})
      string(REPLACE "\r\n" "\n" expected_${stream} "${expected_${stream}}")
    endforeach()
    string(REPLACE "\r\n" "\n" output "${output}")
    string(REPLACE "\r\n" "\n" errors "${errors}")
    if(NOT "${status}" STREQUAL "${expected_status}" OR
        NOT "${output}" STREQUAL "${expected_stdout}" OR
        NOT "${errors}" STREQUAL "${expected_stderr}")
      message(FATAL_ERROR "jdb ${option}: exit=${status}, stdout=[${output}], stderr=[${errors}]")
    endif()
  endif()
endforeach()

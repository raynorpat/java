cmake_minimum_required(VERSION 3.0...3.10)
execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect agent exports: ${errors}")
endif()
string(REPLACE "\n" ";" lines "${output}")
set(actual)
foreach(line ${lines})
  if(line MATCHES "^[0-9A-Fa-f]+[ \t]+[A-Za-z][ \t]+([^ \t]+)$")
    list(APPEND actual "${CMAKE_MATCH_1}")
  endif()
endforeach()
file(STRINGS "${REFERENCE}" expected)
list(SORT actual)
list(SORT expected)
if(NOT "${actual}" STREQUAL "${expected}")
  message(FATAL_ERROR "Agent dynamic exports differ from original: ${actual}")
endif()

cmake_minimum_required(VERSION 3.0...3.10)
# Keep probe DLLs separate so their dependencies resolve from the installed JDK.
if(NOT WIN32)
  message(FATAL_ERROR "The Phase 4 installed AWT gate requires Windows")
endif()
get_filename_component(IMAGE "${IMAGE}" ABSOLUTE)
get_filename_component(OUT "${OUT}" ABSOLUTE)
set(JAVA "${IMAGE}/bin/java.exe")
set(JAVAC "${IMAGE}/bin/javac.exe")
set(JDK "${IMAGE}")
set(LIBDIR "${IMAGE}/bin")
set(COMPARE_ORACLE OFF)
set(ORACLE OFF)
foreach(resource appletviewer.properties awt.properties content-types.properties font.properties font.properties.ja font.properties.ko font.properties.zh font.properties.zh_TW)
  if(NOT EXISTS "${IMAGE}/lib/${resource}")
    message(FATAL_ERROR "Installed AWT resource missing: ${resource}")
  endif()
  file(SHA256 "${IMAGE}/lib/${resource}" installed_hash)
  file(SHA256 "${ROOT}/vendor/jdk1.1.5/lib/${resource}" vendor_hash)
  if(NOT installed_hash STREQUAL vendor_hash)
    message(FATAL_ERROR "Installed AWT resource differs: ${resource}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUT}/probe")
foreach(probe awt115probe awtgraphics115probe awtmenu115probe awtremaining115probe awtclipboard115probe)
  configure_file("${PROBE_DIR}/${probe}.dll" "${OUT}/probe/${probe}.dll" COPYONLY)
endforeach()
set(ENV{PATH} "${IMAGE}/bin;${OUT}/probe;$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
foreach(CLASS Toolkit115 Lifecycle115 DefaultFocus115 FocusLock115 Validation115 Menu115 Input115 Images115 DrawingSurface115 SurfaceLocks115 Clipboard115 EmbeddedFrame115 FrameIcon115 PrintJob115)
  include("${ROOT}/tests/awt/run115.cmake")
endforeach()
message(STATUS "Installed Phase 4 image checks passed")

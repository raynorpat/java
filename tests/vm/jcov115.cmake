cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
if(DEFINED JAVAC)
  file(MAKE_DIRECTORY "${OUT}/classes")
  execute_process(COMMAND "${JAVAC}" -nowarn -prof=jcov -d "${OUT}/classes"
    "${ROOT}/tests/vm/JCov115.java"
    RESULT_VARIABLE compile_status OUTPUT_VARIABLE compile_output ERROR_VARIABLE compile_output TIMEOUT 60)
  if(NOT "${compile_status}" STREQUAL "0" OR NOT "${compile_output}" STREQUAL "")
    message(FATAL_ERROR "Coverage fixture compilation failed (${compile_status}): ${compile_output}")
  endif()
  find_program(patch_python NAMES python3 python)
  if(NOT patch_python)
    message(FATAL_ERROR "Python is required to normalize coverage fixture metadata")
  endif()
  execute_process(COMMAND "${patch_python}" "${ROOT}/tests/vm/patch-jcov115.py" "${OUT}/classes"
    RESULT_VARIABLE patch_status OUTPUT_VARIABLE patch_output ERROR_VARIABLE patch_output)
  if(NOT "${patch_status}" STREQUAL "0")
    message(FATAL_ERROR "Coverage metadata patch failed (${patch_status}): ${patch_output}")
  endif()
  if(NOT DEFINED SEP)
    if(WIN32)
      set(SEP ";")
    else()
      set(SEP ":")
    endif()
  endif()
  set(CP "${OUT}/classes${SEP}${CP}")
endif()
foreach(name java.jcov report.jcov report.jcov.temp report.jcov.temp.lock method.prof)
  file(REMOVE "${OUT}/${name}")
endforeach()
file(READ "${ROOT}/tests/vm/JCov115.expected" expected_stdout)
function(run_cov option expected_stderr)
  execute_process(COMMAND "${JAVA}" "${option}" -classpath "${CP}" JCov115
    WORKING_DIRECTORY "${OUT}" RESULT_VARIABLE status
    OUTPUT_VARIABLE actual_stdout ERROR_VARIABLE actual_stderr TIMEOUT 30)
  string(REPLACE "\r\n" "\n" actual_stdout "${actual_stdout}")
  string(REPLACE "\r\n" "\n" actual_stderr "${actual_stderr}")
  if(NOT "${status}" STREQUAL "0" OR NOT "${actual_stdout}" STREQUAL "${expected_stdout}" OR
     NOT "${actual_stderr}" STREQUAL "${expected_stderr}")
    message(FATAL_ERROR "JCOV run ${option}: exit=${status}, stdout=${actual_stdout}, stderr=${actual_stderr}")
  endif()
endfunction()
function(check_report filename oracle)
  file(READ "${OUT}/${filename}" actual)
  file(READ "${ROOT}/tests/vm/${oracle}" expected)
  string(REPLACE "\r\n" "\n" actual "${actual}")
  string(REPLACE "\r\n" "\n" expected "${expected}")
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "JCOV ${filename} differs from Sun oracle:\n${actual}")
  endif()
endfunction()

run_cov(-prof=jcov:report.jcov "")
if(ENABLED)
  check_report(report.jcov JCov115-first.jcov.expected)
  run_cov(-prof=jcov:report.jcov "")
  check_report(report.jcov JCov115-second.jcov.expected)
  run_cov(-prof=jcov "")
  check_report(java.jcov JCov115-first.jcov.expected)

  file(WRITE "${OUT}/report.jcov.temp.lock" "held")
  run_cov(-prof=jcov:report.jcov "jcov_exit: temp file exists, is someone else running this executable?\n")
  check_report(report.jcov JCov115-second.jcov.expected)
  file(REMOVE "${OUT}/report.jcov.temp.lock")

  file(WRITE "${OUT}/header-only.in" "JCOV-DATA-FILE-VERSION: 1.0\n")
  configure_file("${OUT}/header-only.in" "${OUT}/report.jcov" @ONLY NEWLINE_STYLE UNIX)
  run_cov(-prof=jcov:report.jcov "jcov_exit: malformed coverage file (line 1 489). jcov aborted\n")
  file(READ "${OUT}/report.jcov" preserved)
  if(NOT "${preserved}" STREQUAL "JCOV-DATA-FILE-VERSION: 1.0\n")
    message(FATAL_ERROR "Malformed coverage file was overwritten")
  endif()
else()
  run_cov(-prof=jcov "")
  if(EXISTS "${OUT}/report.jcov" OR EXISTS "${OUT}/java.jcov")
    message(FATAL_ERROR "Release must accept coverage options without writing reports")
  endif()
endif()
if(EXISTS "${OUT}/report.jcov.temp" OR EXISTS "${OUT}/report.jcov.temp.lock")
  message(FATAL_ERROR "Coverage temporary files were not cleaned up")
endif()

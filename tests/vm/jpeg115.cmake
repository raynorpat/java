cmake_minimum_required(VERSION 3.0...3.10)
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${GENERATOR}" "${OUT}" RESULT_VARIABLE generated)
if(NOT generated EQUAL 0)
  message(FATAL_ERROR "Cannot generate JPEG oracle fixtures")
endif()
if(WIN32)
  set(sep ";")
  set(ENV{PATH} "${LIBDIR};$ENV{PATH}")
else()
  set(sep ":")
  set(ENV{LD_LIBRARY_PATH} "${LIBDIR}:$ENV{LD_LIBRARY_PATH}")
endif()
execute_process(COMMAND "${JAVA}" -classpath "${ROOT}/tests/vm${sep}${JDK}/lib/classes.zip"
  JpegLibrary115 "${OUT}" RESULT_VARIABLE status OUTPUT_VARIABLE output
  ERROR_VARIABLE errors TIMEOUT 30)
file(READ "${ROOT}/tests/vm/JpegLibrary115.expected" expected)
string(REPLACE "\r\n" "\n" output "${output}")
string(REPLACE "\r\n" "\n" expected "${expected}")
string(REPLACE "\r\n" "\n" errors "${errors}")
file(READ "${ROOT}/tests/vm/JpegLibrary115.stderr" expected_errors)
string(REPLACE "\r\n" "\n" expected_errors "${expected_errors}")
if(NOT status EQUAL 0 OR NOT output STREQUAL expected OR NOT errors STREQUAL expected_errors)
  message(FATAL_ERROR "JPEG oracle mismatch (${status}):\n${output}\n${errors}")
endif()
